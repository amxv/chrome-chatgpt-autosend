{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "ChatGPT Auto-Send for Chrome",
  "version": "1.3.0",
  "description": "Opens ChatGPT from a site-search shortcut, selects Chat instead of Work, and automatically submits the prompt.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "webNavigation",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
